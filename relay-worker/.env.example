# Relay worker secrets. `npm run setup` writes them to relay-worker/.secrets.json;
# upload with `npx wrangler secret bulk .secrets.json` (or .dev.vars for `wrangler dev`).
# Never commit real values. Generate a key with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# Shared with every bridge device's RELAY_AGENT_KEY. Encrypts queued requests (AES-256-GCM).
WA_AGENT_KEY=
# Key AI clients (or the Claude doorway's CLIENT_KEY) send in the X-Relay-Client-Key header.
WA_CLIENT_KEY=
