# Claude forwarder (Cloudflare Worker). Copy to .dev.vars for local dev, and set
# each one in production with `npx wrangler secret put NAME`. Never commit real values.

# Your relay's MCP endpoint.
RELAY_URL=https://your-relay.example.com/whatsapp/mcp
# Key Claude sends in the x-api-key header (choose a long random value).
PROXY_KEY=
# Access credential for the relay host, sent as "OAI-Sites-Authorization: Bearer <SITE_KEY>" (if your host needs one).
SITE_KEY=
# Must equal the relay's WA_CLIENT_KEY.
CLIENT_KEY=
