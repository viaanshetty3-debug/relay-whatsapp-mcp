# Bridge (WhatsApp side). Copy to .env and fill in. Never commit .env.
HOST=127.0.0.1
PORT=8787
# PUBLIC_URL=https://your-bridge.example.com
# DATA_DIR=./data
# AUTO_CONNECT=true
# READ_ONLY=true
# Optional comma-separated chat JIDs. Empty means all chats.
# ALLOWED_CHATS=15551234567@s.whatsapp.net,123456789@g.us
# Optional token override. Otherwise generated and persisted privately in DATA_DIR.
# BRIDGE_TOKEN=

# Dashboard sign-in. You create one owner account on the dashboard (full name, country,
# phone, email + password); Relay emails a 5-digit code to confirm the email.
# SMTP_URL=smtps://you%40gmail.com:your-16-letter-app-password@smtp.gmail.com:465
# MAIL_FROM=Relay <you@gmail.com>
# Optional "Sign in with ..." buttons. Register an OAuth app with each provider and use the
# redirect URL http://localhost:8787/auth/callback/<google|microsoft|github|facebook>.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=

# Remote agent (connects this bridge to your hosted relay). These override
# data/remote-link.json. Generate keys with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# RELAY_REMOTE_URL=https://your-relay.example.com
# RELAY_SITE_KEY=           # access credential for your relay host, if it requires one
# RELAY_AGENT_KEY=          # must equal WA_AGENT_KEY on the relay
# RELAY_AGENT_ID=           # a UUID shared by all your devices
# RELAY_DEVICE_ID=          # a UUID unique to THIS device
# RELAY_FAILOVER_ROLE=      # primary (default) | standby
# RELAY_WATCH_MS=750        # standby only: how often to check the primary; 3000 keeps Cloudflare free-tier request use low
# RELAY_LOCAL_URL=http://127.0.0.1:8787

# Optional: moving a session from Termux (Android) to a Mac over SSH
# TERMUX_SSH_TARGET=u0_a123@192.168.1.50
# TERMUX_SSH_PORT=8022

# Optional: macOS login items label prefix
# RELAY_LAUNCHD_PREFIX=com.example.whatsapp-relay
